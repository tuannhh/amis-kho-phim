# AMIS Kho phim — mẫu biến môi trường. Copy sang .env rồi chỉnh.
# cp .env.example .env

# ── Cổng truy cập (đổi nếu trùng cổng đang dùng trên máy) ──────
NGINX_PORT=8180

# ── MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307
DB_NAME=kho_phim
DB_USER=khophim
DB_PASSWORD=khophim

# ── JWT — BẮT BUỘC ĐỔI khi triển khai thật ─────
# Giá trị dưới đây CHỈ dùng cho máy dev. Backend TỪ CHỐI KHỞI ĐỘNG khi NODE_ENV=production
# mà secret còn mặc định / ngắn hơn 32 ký tự / hai secret trùng nhau (GĐ7 — security.config.ts).
# Sinh secret thật:  openssl rand -hex 32
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Seed super_admin đầu tiên (tạo lúc khởi động nếu chưa có) ──
SEED_SUPER_ADMIN_EMAIL=superadmin@misa.com.vn
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_SUPER_ADMIN_NAME=Super Admin

# ── MinIO (S3) ─────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kho-phim
MINIO_API_PORT=9200
MINIO_CONSOLE_PORT=9201
# Endpoint trình duyệt gọi được để upload presigned PUT thẳng lên MinIO
# (khớp cổng host MINIO_API_PORT). Đổi thành domain thật khi lên production.
MINIO_PUBLIC_ENDPOINT=http://localhost:9200

# ── Giới hạn & nghiệp vụ ───────────────────────
MAX_UPLOAD_MB=2048
NEW_FILM_TTL_DAYS=14

# ── Frontend (dev) ─────────────────────────────
VITE_API_BASE=/api

# ── GĐ7 — Bảo mật & vận hành ───────────────────
# ‼️ CỜ CHỈ DÀNH CHO MÁY DEV — XOÁ DÒNG NÀY TRƯỚC KHI LÊN PRODUCTION.
# Khi = true, backend chấp nhận chạy với secret mẫu ở trên và chỉ in cảnh báo ra log.
# Khi xoá (hoặc đặt khác "true"), backend TỪ CHỐI KHỞI ĐỘNG nếu còn secret mặc định,
# MinIO còn minioadmin, hay MINIO_PUBLIC_ENDPOINT còn localhost. Đây là chốt chặn cuối
# cùng chống việc vô tình đưa cấu hình dev lên thật — xem docs/devops-handoff.md.
ALLOW_INSECURE_CONFIG=true
# Origin được phép gọi API (phân tách bằng dấu phẩy). Để TRỐNG là đúng cho triển khai
# chuẩn (FE + API cùng origin qua nginx). Chỉ điền khi FE nằm ở domain khác.
CORS_ORIGINS=
# Bật trang Swagger /api/docs ở production (mặc định TẮT — tránh phơi toàn bộ API surface).
# Chỉ bật khi đã có VPN/IP allowlist đứng trước.
ENABLE_API_DOCS=false

# ── Retrofit 2026-08-12 — Multi-replica gate (Production Compatibility Gate) ───
# Mặc định: KHÔNG đặt cả hai biến dưới đây (đúng deploy 1 container/service hiện tại của
# docker-compose/Cloud Run — không đổi hành vi cũ).
# Khi triển khai NHIỀU bản sao (K8s/Swarm nhiều Pod cùng service backend), BẮT BUỘC khai:
#   MULTI_REPLICA=true
#   RUN_MIGRATIONS_ON_BOOT=false   (chạy migration bằng MỘT job riêng trước khi rollout,
#                                    vd `npm run migration:run` trong K8s Job)
#   REDIS_URL=rediss://:PASSWORD@redis.internal:6380/0
# Khai MULTI_REPLICA=true mà quên tắt RUN_MIGRATIONS_ON_BOOT → backend TỪ CHỐI KHỞI ĐỘNG
# (xem security.config.ts#collectConfigIssues) — mỗi Pod tự chạy migration cùng lúc lúc
# khởi động có thể đua nhau đổi schema giữa chừng.
# MULTI_REPLICA=true
# RUN_MIGRATIONS_ON_BOOT=false
# REDIS_URL=
# Diễn tập local hai backend (không đưa giá trị localhost này lên production):
# MULTI_REPLICA_BACKEND_A_PORT=8301
# MULTI_REPLICA_BACKEND_B_PORT=8302

# ── GĐ6.1 — SSO AMIS Mobile (PLACEHOLDER, chờ DevOps/đội AMIS Mobile spec thật) ──
# Rỗng = TÍNH NĂNG TẮT (an toàn mặc định). Xác minh tạm bằng HMAC-SHA256, KHÔNG phải
# OIDC/JWKS thật — DevOps chỉ set biến này khi đã có spec bridge chính thức và đã thay
# AuthService.verifySsoToken bằng cơ chế xác minh thật tương ứng.
AMIS_SSO_SHARED_SECRET=
# Trần hạn dùng của token SSO (giây) — giới hạn cửa sổ replay khi token bị lộ.
AMIS_SSO_MAX_TTL_SECONDS=300
