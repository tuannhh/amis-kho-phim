# AMIS Kho phim — mẫu biến môi trường. Copy sang .env rồi chỉnh.
# cp .env.example .env

# ── Cổng truy cập (đổi nếu trùng cổng đang dùng trên máy) ──────
NGINX_PORT=8180

# ── MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307
DB_NAME=kho_phim
DB_USER=khophim
DB_PASSWORD=khophim

# ── JWT (ĐỔI khi triển khai thật) ──────────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Seed super_admin đầu tiên (tạo lúc khởi động nếu chưa có) ──
SEED_SUPER_ADMIN_EMAIL=superadmin@misa.com.vn
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_SUPER_ADMIN_NAME=Super Admin

# ── MinIO (S3) ─────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kho-phim
MINIO_API_PORT=9200
MINIO_CONSOLE_PORT=9201

# ── Giới hạn & nghiệp vụ ───────────────────────
MAX_UPLOAD_MB=2048
NEW_FILM_TTL_DAYS=14

# ── Frontend (dev) ─────────────────────────────
VITE_API_BASE=/api
